generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("citizen")
  voterId          String      @unique
  isVoterVerified  Boolean     @default(false)
  createdAt DateTime @default(now())
  complaints Complaint[]
  
}
model Complaint {
  id           String   @id @default(uuid())
  title        String
  description  String
  category     String   @default("Other")
  urgency      String   @default("low")
  status       String   @default("filed")
  photoUrl     String?
  latitude     Float?
  longitude    Float?
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  statusLogs ComplaintStatusLog[]
}


model ComplaintStatusLog {
  id          String   @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  status      String
  changedBy   String
  note        String?
  createdAt   DateTime @default(now())
}
model GovProject {
  id                String    @id @default(uuid())
  title             String
  department        String
  budgetAllocated   Float
  contractorName    String
  tenderReference   String?
  startDate         DateTime?
  expectedEndDate   DateTime?
  status            String    @default("ongoing")
  progressPercent   Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expenses          Expense[]
}

model Expense {
  id                String     @id @default(uuid())
  projectId         String
  project           GovProject @relation(fields: [projectId], references: [id])
  amount            Float
  receiptReference  String?
  description       String
  dateSubmitted     DateTime   @default(now())
  flagged           Boolean    @default(false)
  flagReason         String?
}
